-- NEXA POS rider login, attendance and live GPS support.
-- Run once in Supabase SQL Editor.
alter table public.pos_riders add column if not exists profile_id uuid references auth.users(id) on delete set null;
alter table public.pos_riders add column if not exists on_duty boolean not null default false;
alter table public.pos_riders add column if not exists cash_balance numeric not null default 0;
create unique index if not exists pos_riders_profile_id_uq on public.pos_riders(profile_id) where profile_id is not null;

create table if not exists public.pos_rider_attendance(
 id uuid primary key default gen_random_uuid(),
 rider_id uuid not null references public.pos_riders(id) on delete cascade,
 branch_id uuid not null references public.pos_branches(id) on delete cascade,
 started_at timestamptz not null default now(),
 ended_at timestamptz,
 start_latitude double precision,
 start_longitude double precision,
 created_at timestamptz not null default now()
);
create table if not exists public.pos_rider_locations(
 id bigint generated by default as identity primary key,
 rider_id uuid not null references public.pos_riders(id) on delete cascade,
 branch_id uuid not null references public.pos_branches(id) on delete cascade,
 latitude double precision not null,
 longitude double precision not null,
 accuracy_m double precision,
 recorded_at timestamptz not null default now()
);
create index if not exists pos_rider_locations_rider_time_idx on public.pos_rider_locations(rider_id,recorded_at desc);

-- Link existing rider records to Delivery Boy/Rider profiles where branch + name match.
update public.pos_riders r set profile_id=p.id
from public.pos_profiles p
where r.profile_id is null and r.branch_id=p.branch_id
  and lower(trim(coalesce(r.name,'')))=lower(trim(coalesce(p.name,'')))
  and lower(replace(coalesce(p.role,''),' ','')) in ('deliveryboy','rider','deliveryrider');

alter table public.pos_rider_attendance enable row level security;
alter table public.pos_rider_locations enable row level security;

drop policy if exists pos_rider_attendance_auth on public.pos_rider_attendance;
create policy pos_rider_attendance_auth on public.pos_rider_attendance for all to authenticated using(true) with check(true);
drop policy if exists pos_rider_locations_auth on public.pos_rider_locations;
create policy pos_rider_locations_auth on public.pos_rider_locations for all to authenticated using(true) with check(true);

-- Ensure authenticated users can read/update rider rows. Existing stricter policies may still apply.
alter table public.pos_riders enable row level security;
drop policy if exists pos_riders_authenticated_access on public.pos_riders;
create policy pos_riders_authenticated_access on public.pos_riders for all to authenticated using(true) with check(true);

-- Realtime GPS, safe if already added.
do $$ begin alter publication supabase_realtime add table public.pos_rider_locations; exception when duplicate_object then null; end $$;
notify pgrst, 'reload schema';
